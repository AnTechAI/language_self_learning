{
  "name": "english-learning",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "dev": "npm run dev -w @english/web",
    "build": "npm run build -w @english/web",
    "preview": "npm run preview -w @english/web",
    "test": "node _e2e.js",
    "test:react": "npm run test -w @english/web",
    "typecheck": "npm run typecheck -w @english/shared && npm run typecheck -w @english/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api": "uvicorn apps.api.main:app --reload --port 8000",
    "data": "node data/scripts/cli.js",
    "data:lessons": "node data/scripts/cli.js lessons",
    "data:chunks": "node data/scripts/cli.js chunks",
    "data:seed": "node data/scripts/cli.js seed",
    "data:icons": "node data/scripts/cli.js icons",
    "data:enrich": "node data/scripts/cli.js enrich",
    "data:fetch": "node data/scripts/cli.js fetch",
    "data:build": "node data/scripts/cli.js build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.67.0"
  }
}
